# VoiceOps 2026 Environment Configuration Example
# Copy this file to .env and populate your actual API keys.
# NEVER commit your actual .env file or API keys to Git!

# Gnani Voice API Key (covers both STT and TTS)
# Obtain from: https://app.gnani.ai/voice
GNANI_API_KEY=

# Optional LLM API Keys (defaults to local deterministic reasoner if left blank)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Path to the capstone dataset folder (optional, default auto-detected)
DATASET_DIR=
